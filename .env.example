# BVK Hydrotech — Environment Variables Example
# Copy this file to .env.local and fill in real values

# WordPress Backend URL (NO trailing slash)
NEXT_PUBLIC_WORDPRESS_URL=https://dev.bhavcreations.in

# WPGraphQL Endpoint
WORDPRESS_GRAPHQL_URL=https://dev.bhavcreations.in/graphql

# Frontend URL (production)
NEXT_PUBLIC_SITE_URL=https://bvkhydrotech.com

# Site name (used in metadata)
NEXT_PUBLIC_SITE_NAME=BVK Hydrotech

# WordPress Application Password (for authenticated requests)
# Create at: WP Admin → Users → Profile → Application Passwords
WORDPRESS_USERNAME=marketing@bvkgroup.in
WORDPRESS_APP_PASSWORD=your-application-password-here

# ISR Revalidation Secret (use a strong random string)
REVALIDATION_SECRET=change-this-to-a-strong-random-secret

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXX

# reCAPTCHA (for forms)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Contact form email (server-side only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=marketing@bvkgroup.in
SMTP_PASS=your-smtp-app-password
CONTACT_EMAIL_TO=marketing@bvkgroup.in
